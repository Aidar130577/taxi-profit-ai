+package kz.taxiprofitai
+
+import java.time.Instant
+import java.time.ZoneId
+
+enum class RideWeather {
+    UNKNOWN, DRY, RAIN, SNOW;
+
+    companion object {
+        fun fromSymbol(symbol: String): RideWeather = when {
+            symbol.isBlank() -> UNKNOWN
+            "snow" in symbol || "sleet" in symbol -> SNOW
+            "rain" in symbol -> RAIN
+            else -> DRY
+        }
+    }
+}
+
+/** Learns duration from comparable completed routes on this phone. */
+object RideTimeLearning {
+    private val city = ZoneId.of("Asia/Almaty")
+    private val retention = 45L * 24 * 60 * 60 * 1000
+
+    fun estimate(route: OfflineRoute, rows: List<LocalTrial>, now: Long, weather: RideWeather = RideWeather.UNKNOWN): Double {
+        val local = Instant.ofEpochMilli(now).atZone(city)
+        val base = if (local.hour in 6..22) maxOf(route.minutes, route.km * 2) else route.minutes
+        val similar = rows.filter { row ->
+            val minutes = row.actualMinutes
+            val sourceMinutes = row.offlineMinutes ?: row.minutes
+            val trip = Instant.ofEpochMilli(row.createdAtMs).atZone(city)
+            row.createdAtMs in (now - retention)..now && period(local.hour, local.minute) == period(trip.hour, trip.minute) && row.weather == weather &&
+                row.km in (route.km * 0.55)..(route.km * 1.8) &&
+                (row.actualKm == null || row.actualKm in (row.km * 0.75)..(row.km * 1.25)) &&
+                sourceMinutes > 0 && minutes != null && minutes in 2.0..240.0 &&
+                minutes / sourceMinutes in 0.45..3.0
+        }.distinctBy { it.id }.take(50)
+        if (similar.size < 5 || similar.map {
+                Instant.ofEpochMilli(it.createdAtMs).atZone(city).toLocalDate()
+            }.distinct().size < 2) return base
+
+        val ratios = similar.map { it.actualMinutes!! / (it.offlineMinutes ?: it.minutes) }.sorted()
+        val ratio = (ratios[(ratios.size - 1) / 2] + ratios[ratios.size / 2]) / 2
+        return (route.minutes * ratio).coerceIn(base * 0.75, base * 1.8)
+    }
+
+    private fun period(hour: Int, minute: Int): Int {
+        val clock = hour * 60 + minute
+        return when (clock) {
+            in 420 until 570 -> 1
+            in 1020 until 1260 -> 2
+            in 360 until 1380 -> 3
+            else -> 0
+        }
+    }
+}
+
+enum class RidePhase { READY, ACTIVE, COMPLETED, CANCELLED, OTHER }
+
+class RideTiming {
+    data class Fact(val rowId: Long, val minutes: Double)
+    private data class Offer(val id: Long, val destination: String, val elapsed: Long)
+    private var offer: Offer? = null
+    private var readyAt: Long? = null
+    private var startAt: Long? = null
+    val active get() = startAt != null
+
+    fun offer(id: Long, destination: String, elapsed: Long) {
+        if (offer?.id == id || startAt != null) return
+        reset()
+        offer = Offer(id, destination, elapsed)
+    }
+
+    fun observe(phase: RidePhase, destinations: List<String>, elapsed: Long): Fact? {
+        val current = offer ?: return null
+        val matches = destinations.any { OrderTextParser.samePoint(current.destination, it) }
+        when (phase) {
+            RidePhase.READY -> {
+                if (startAt != null) reset()
+                else if (matches && elapsed - current.elapsed in 0L..1_800_000L) readyAt = elapsed
+                else readyAt = null
+            }
+            RidePhase.ACTIVE -> {
+                val ready = readyAt
+                if (startAt == null && ready != null && matches && elapsed - ready in 0L..30_000L) {
+                    startAt = elapsed
+                } else if (startAt != null && destinations.isNotEmpty() && !matches) reset()
+            }
+            RidePhase.COMPLETED -> {
+                val minutes = startAt?.let { (elapsed - it) / 60_000.0 }
+                reset()
+                return minutes?.takeIf { it in 2.0..240.0 }?.let { Fact(current.id, it) }
+            }
+            RidePhase.CANCELLED -> reset()
+            RidePhase.OTHER -> Unit
+        }
+        return null
+    }
+
+    fun reset() {
+        offer = null
+        readyAt = null
+        startAt = null
+    }
+}
