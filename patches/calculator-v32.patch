+package kz.taxiprofitai
+
+import android.content.Context
+import org.json.JSONObject
+import java.net.URL
+import java.time.Instant
+import java.util.concurrent.Executors
+import javax.net.ssl.HttpsURLConnection
+
+/** Requests only fixed Almaty city coordinates. Cached forecasts never contain driver locations. */
+object CityWeather {
+    const val ENABLED = "weather_almaty_enabled"
+    const val TERMS = "https://docs.api.met.no/doc/TermsOfService.html"
+    private const val CITY_URL = "https://api.met.no/weatherapi/locationforecast/2.0/compact?lat=43.24&lon=76.95"
+    private val worker = Executors.newSingleThreadExecutor()
+    private var inFlight = false
+
+    fun condition(context: Context, now: Long): RideWeather {
+        if (!context.getSharedPreferences("taxi_profit_settings", Context.MODE_PRIVATE).getBoolean(ENABLED, false)) {
+            return RideWeather.UNKNOWN
+        }
+        val cache = context.getSharedPreferences("almaty_weather_cache", Context.MODE_PRIVATE)
+        val raw = cache.getString("forecast", null)
+        if (now >= cache.getLong("expires", 0L)) refresh(context.applicationContext)
+        return raw?.let { parse(it, now) } ?: RideWeather.UNKNOWN
+    }
+
+    @Synchronized private fun refresh(context: Context) {
+        if (inFlight) return
+        inFlight = true
+        worker.execute {
+            try {
+                val cache = context.getSharedPreferences("almaty_weather_cache", Context.MODE_PRIVATE)
+                val now = System.currentTimeMillis()
+                if (now < cache.getLong("expires", 0L)) return@execute
+                val conn = URL(CITY_URL).openConnection() as HttpsURLConnection
+                try {
+                    conn.connectTimeout = 6_000
+                    conn.readTimeout = 6_000
+                    conn.setRequestProperty("User-Agent", "ZnayTsenu/0.32 (https://github.com/Aidar130577)")
+                    val prior = cache.getLong("lastModified", 0L)
+                    if (prior > 0) conn.ifModifiedSince = prior
+                    val code = conn.responseCode
+                    val expires = maxOf(now + 30 * 60_000L, conn.expiration)
+                    val edit = cache.edit().putLong("expires", expires)
+                    if (code == 200 || code == 203) {
+                        val data = conn.inputStream.bufferedReader().use { it.readText() }
+                        if (data.length <= 1_500_000) {
+                            edit.putString("forecast", data).putLong("lastModified", conn.lastModified)
+                        }
+                    }
+                    edit.apply()
+                } finally {
+                    conn.disconnect()
+                }
+            } catch (_: Exception) {
+                context.getSharedPreferences("almaty_weather_cache", Context.MODE_PRIVATE).edit()
+                    .putLong("expires", System.currentTimeMillis() + 30 * 60_000L).apply()
+            } finally {
+                synchronized(this) { inFlight = false }
+            }
+        }
+    }
+
+    private fun parse(data: String, now: Long): RideWeather = runCatching {
+        val times = JSONObject(data).getJSONObject("properties").getJSONArray("timeseries")
+        for (index in 0 until times.length()) {
+            val entry = times.getJSONObject(index)
+            val time = Instant.parse(entry.getString("time")).toEpochMilli()
+            if (now - time !in 0L until 3_600_000L) continue
+            val near = entry.getJSONObject("data").optJSONObject("next_1_hours")
+                ?.optJSONObject("summary")?.optString("symbol_code").orEmpty()
+            return RideWeather.fromSymbol(near)
+        }
+        RideWeather.UNKNOWN
+    }.getOrDefault(RideWeather.UNKNOWN)
+}
