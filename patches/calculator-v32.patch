+package kz.taxiprofitai
+
+import android.app.Notification
+import android.app.NotificationChannel
+import android.app.NotificationManager
+import android.app.Service
+import android.content.Context
+import android.content.Intent
+import android.content.pm.ServiceInfo
+import android.location.Location
+import android.location.LocationListener
+import android.location.LocationManager
+import android.os.Build
+import android.os.Bundle
+import android.os.IBinder
+import android.os.SystemClock
+
+/** Keeps permission while Yandex Pro is in front. Fixes are collected only during a detected ride. */
+class RideGpsService : Service(), LocationListener {
+    companion object {
+        private const val CHANNEL = "ride_gps"
+        private var current: RideGpsService? = null
+        fun record(active: Boolean) { current?.recordRide(active) }
+        fun distanceKm(minutes: Double): Double? = current?.measuredDistance(minutes)
+        fun stop(context: Context) { context.stopService(Intent(context, RideGpsService::class.java)) }
+    }
+
+    private lateinit var locations: LocationManager
+    private var recording = false
+    private var prior: Location? = null
+    private var firstFix = 0L
+    private var samples = 0
+    private var totalMetres = 0.0
+    private var gaps = false
+
+    override fun onCreate() {
+        super.onCreate()
+        locations = getSystemService(LocationManager::class.java)
+        getSystemService(NotificationManager::class.java).createNotificationChannel(
+            NotificationChannel(CHANNEL, "GPS поездок", NotificationManager.IMPORTANCE_LOW)
+        )
+    }
+
+    override fun onStartCommand(intent: Intent?, flags: Int, startId: Int): Int {
+        val notice = Notification.Builder(this, CHANNEL)
+            .setContentTitle("Знай цену · GPS поездок")
+            .setContentText("Расстояние измеряется во время поездки")
+            .setSmallIcon(android.R.drawable.ic_menu_mylocation)
+            .setOngoing(true)
+            .build()
+        try {
+            if (Build.VERSION.SDK_INT >= 29) startForeground(4701, notice, ServiceInfo.FOREGROUND_SERVICE_TYPE_LOCATION)
+            else startForeground(4701, notice)
+            current = this
+        } catch (_: SecurityException) {
+            stopSelf()
+        }
+        return START_NOT_STICKY
+    }
+
+    fun recordRide(active: Boolean) {
+        if (active == recording) return
+        recording = active
+        if (!active) {
+            locations.removeUpdates(this)
+            return
+        }
+        prior = null
+        firstFix = 0L
+        totalMetres = 0.0
+        samples = 0
+        gaps = false
+        try {
+            locations.requestLocationUpdates(LocationManager.GPS_PROVIDER, 2_000L, 0f, this, mainLooper)
+        } catch (_: SecurityException) {
+            recording = false
+        } catch (_: IllegalArgumentException) {
+            recording = false
+        }
+    }
+
+    override fun onLocationChanged(location: Location) {
+        if (!recording || location.isFromMockProvider || !location.hasAccuracy() || location.accuracy > 25f) return
+        val time = location.elapsedRealtimeNanos
+        if (SystemClock.elapsedRealtimeNanos() - time !in 0L..10_000_000_000L) return
+        val old = prior
+        if (old == null) {
+            firstFix = time
+        } else {
+            val seconds = (time - old.elapsedRealtimeNanos) / 1_000_000_000.0
+            if (seconds <= 0) return
+            val metres = old.distanceTo(location).toDouble()
+            if (seconds > 45 || metres / seconds > 55) gaps = true
+            else if (metres >= 5 && (!location.hasSpeed() || location.speed >= 0.8f)) totalMetres += metres
+        }
+        prior = location
+        samples++
+    }
+
+    private fun measuredDistance(minutes: Double): Double? {
+        val last = prior ?: return null
+        val coverage = (last.elapsedRealtimeNanos - firstFix) / 60_000_000_000.0
+        return (totalMetres / 1000).takeIf { recording && !gaps && samples >= 5 &&
+            coverage >= minutes * 0.8 && it in 0.2..300.0 }
+    }
+
+    override fun onStatusChanged(provider: String?, status: Int, extras: Bundle?) = Unit
+    override fun onProviderEnabled(provider: String) = Unit
+    override fun onProviderDisabled(provider: String) { if (recording) gaps = true }
+    override fun onBind(intent: Intent?): IBinder? = null
+
+    override fun onDestroy() {
+        if (current === this) current = null
+        recordRide(false)
+        super.onDestroy()
+    }
+}
