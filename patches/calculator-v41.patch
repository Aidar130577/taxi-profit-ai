+internal object FastRouteEstimate {
+    const val SHOW_AFTER_MS = 650L
+
+    fun between(latA: Double, lonA: Double, latB: Double, lonB: Double): OfflineRoute? {
+        val latDelta = Math.toRadians(latB - latA)
+        val lonDelta = Math.toRadians(lonB - lonA)
+        val a = Math.toRadians(latA)
+        val b = Math.toRadians(latB)
+        val chord = kotlin.math.sin(latDelta / 2).let { it * it } +
+            kotlin.math.cos(a) * kotlin.math.cos(b) * kotlin.math.sin(lonDelta / 2).let { it * it }
+        val directKm = 12_742 * kotlin.math.asin(kotlin.math.sqrt(chord.coerceIn(0.0, 1.0)))
+        if (directKm !in 0.12..25.0) return null
+        // Approximate urban road distance and 30 km/h. The road router replaces both figures.
+        val km = directKm * 1.35
+        return OfflineRoute(km, maxOf(2.0, km * 2), "Предварительно · без маршрута", provisional = true)
+    }
+}
