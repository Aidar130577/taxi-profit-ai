+package kz.taxiprofitai
+
+import java.time.LocalDate
+import kotlin.math.abs
+import kotlin.math.round
+
+data class LocalTrial(
+    val id: Long,
+    val tariff: String,
+    val forecastGross: Double,
+    val km: Double,
+    val minutes: Double,
+    val createdAtMs: Long,
+    val demandLabel: String,
+    val actualGross: Double? = null,
+    val latencyMs: Long? = null,
+    val fixedSurcharge: Double? = null,
+    val tariffRevision: String? = null,
+    val learningDay: LocalDate? = null
+)
+
+/** Adapts the v4 temporal validation to one driver's confirmed trips. */
+object LocalFareLearning {
+    private const val MIN_TRAIN = 8
+    private const val MIN_CHECK = 4
+
+    fun correction(
+        rows: List<LocalTrial>, tariff: String, revision: String, km: Double,
+        minutes: Double, surcharge: Double, today: LocalDate
+    ): Double {
+        val observations = rows.filter { row ->
+            val day = row.learningDay
+            val actual = row.actualGross
+            val recordedSurcharge = row.fixedSurcharge
+            row.tariff == tariff && row.tariffRevision == revision &&
+                band(row.km, 5.0) == band(km, 5.0) &&
+                band(row.minutes, 15.0) == band(minutes, 15.0) &&
+                day != null && day >= today.minusDays(28) && day < today &&
+                actual != null && actual.isFinite() && actual >= 100 && actual <= 100_000 &&
+                recordedSurcharge != null && recordedSurcharge.isFinite() && recordedSurcharge >= 0 &&
+                (recordedSurcharge > 0) == (surcharge > 0) &&
+                row.forecastGross.isFinite() && row.forecastGross <= 100_000 &&
+                row.forecastGross - recordedSurcharge >= 100 && actual - recordedSurcharge >= 100
+        }.distinctBy { it.id }
+        val (training, validation) = observations.partition { it.learningDay!! < today.minusDays(7) }
+        if (training.size < MIN_TRAIN || training.map { it.learningDay }.distinct().size < 3 ||
+            validation.size < MIN_CHECK) return 1.0
+
+        val ratios = training.map {
+            (it.actualGross!! - it.fixedSurcharge!!) / (it.forecastGross - it.fixedSurcharge)
+        }.sorted()
+        val median = (ratios[(ratios.size - 1) / 2] + ratios[ratios.size / 2]) / 2
+        val factor = median.coerceIn(0.8, 1.2)
+        val originalError = validation.map { abs(it.actualGross!! - it.forecastGross) }.average()
+        val correctedError = validation.map {
+            abs(it.actualGross!! - apply(it.forecastGross, it.fixedSurcharge!!, factor))
+        }.average()
+        return if (originalError > 0 && correctedError <= originalError * 0.95) factor else 1.0
+    }
+
+    fun apply(gross: Double, surcharge: Double, factor: Double): Double =
+        round(((gross - surcharge) * factor + surcharge) * 100) / 100
+
+    private fun band(value: Double, size: Double) = (value / size).toInt()
+}
