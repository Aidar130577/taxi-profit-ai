--- /dev/null
+++ b/core-tests/LocalFareLearningCheck.kt
@@ -0,0 +1,38 @@
+package kz.taxiprofitai
+
+import java.time.LocalDate
+import kotlin.math.abs
+
+fun main() {
+    val day = LocalDate.parse("2026-11-25")
+    val revision = "test"
+    val training = (0..7).map { i ->
+        LocalTrial(i.toLong(), "Business", 2_000.0, 8.0, 20.0, 0, "+200 ₸", 2_180.0,
+            fixedSurcharge = 200.0, tariffRevision = revision,
+            learningDay = day.minusDays((8 + i % 3).toLong()))
+    }
+    val validation = (8..11).map { i ->
+        training.first().copy(id = i.toLong(), learningDay = day.minusDays(2))
+    }
+    fun correction(rows: List<LocalTrial>, tariff: String = "Business", surcharge: Double = 200.0,
+                   version: String = revision, km: Double = 8.0): Double =
+        LocalFareLearning.correction(rows, tariff, version, km, 20.0, surcharge, day)
+    val ready = training + validation
+    check(abs(correction(ready) - 1.1) < 0.000001)
+    check(LocalFareLearning.apply(2_000.0, 200.0, 1.1) == 2_180.0)
+    check(correction(training) == 1.0)
+    check(correction(training + validation.map { it.copy(actualGross = 1_950.0) }) == 1.0)
+    check(correction(training + List(4) { validation.first() }) == 1.0)
+    check(correction(training + validation.map { it.copy(learningDay = day) }) == 1.0)
+    check(correction(ready, tariff = "Premier") == 1.0)
+    check(correction(ready, surcharge = 0.0) == 1.0)
+    check(correction(ready, km = 13.0) == 1.0)
+    check(correction(ready, version = "older") == 1.0)
+    val offer = "Пропустить\nBusiness\nСтоимость поездки: 3 000 ₸\n+50 ₸\nПринять"
+    check(OrderTextParser.parse(offer).displayedGross == 3000.0)
+    check(OrderTextParser.parse(offer.replace("Стоимость поездки: 3 000 ₸\n", "")).displayedGross == null)
+    check(OrderTextParser.parse(offer.replace("Пропустить", "")).displayedGross == null)
+    check(OrderTextParser.parse(offer + "\nЦена: 2 000 ₸").displayedGross == null)
+    check(NetQuotePresenter.present(LiveFareEstimate(3000.0, 2394.0, 0.0, 0.0, "Карточка", fromOrder=true), 1.0).grossText == "3 000 ₸")
+    println("15 local learning and visible fare checks passed")
+}
