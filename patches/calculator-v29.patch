+package kz.taxiprofitai
+
+import java.text.Normalizer
+import java.util.Locale
+
+/** These normalizations match build_almaty_index.py. */
+object AlmatyLookupKey {
+    private val words = Regex("""[^\p{L}\p{N}]+""")
+    private val street = Regex("""(?iu)\b(?:улица|ул|проспект|просп|пр|микрорайон|мкр|көшесі|даңғылы|street|avenue)\b""")
+    private val corpus = Regex("""(?iu)(\d+[а-яa-z]?)\s*(?:корпус|корп|к|k)\s*(\d+[а-яa-z]?)\b""")
+    private val prefix = Regex("""(?iu)^(?:кафе|кофейня|ресторан|магазин|трц|тц|бц|жк|здание|отель|гостиница)\s+""")
+    private val city = Regex("""(?iu)(?:^Алматы\s*,\s*|\s*,\s*(?:город\s+)?Алматы(?:\s*,\s*Казахстан)?\s*$)""")
+
+    private val nazarbayev = Regex("""^(?:имени нурсултана )?назарбаева (?=\d)""")
+    private val latin = mapOf(
+        'а' to "a", 'б' to "b", 'в' to "v", 'г' to "g", 'д' to "d", 'е' to "e", 'ж' to "zh",
+        'з' to "z", 'и' to "i", 'й' to "y", 'к' to "k", 'л' to "l", 'м' to "m", 'н' to "n",
+        'о' to "o", 'п' to "p", 'р' to "r", 'с' to "s", 'т' to "t", 'у' to "u", 'ф' to "f",
+        'х' to "kh", 'ц' to "ts", 'ч' to "ch", 'ш' to "sh", 'щ' to "shch", 'ы' to "y",
+        'э' to "e", 'ю' to "yu", 'я' to "ya", 'ь' to "", 'ъ' to "",
+        'ә' to "a", 'ғ' to "g", 'қ' to "k", 'ң' to "ng", 'ө' to "o", 'ұ' to "u",
+        'ү' to "u", 'һ' to "h", 'і' to "i"
+    )
+
+    fun candidates(raw: String, address: Boolean): List<String> {
+        val native = normalize(raw, address)
+        val alternate = if (address) native.replace(nazarbayev, "назарбаев ")
+            else native.map { latin[it] ?: it.toString() }.joinToString("")
+        return listOf(native, alternate).distinct().filter { it.length >= 3 }
+    }
+
+    fun normalize(raw: String, address: Boolean): String {
+        val text = Normalizer.normalize(raw.replace(city, ""), Normalizer.Form.NFKC)
+            .lowercase(Locale.ROOT).replace('ё', 'е').trim()
+        val cleaned = if (address) text.replace(corpus, "$1 корпус $2").replace(street, " ")
+            else text.replace(prefix, "")
+        return cleaned.replace(words, " ").trim()
+    }
+}
