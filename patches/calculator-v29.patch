+package kz.taxiprofitai
+
+import android.content.Context
+import android.database.sqlite.SQLiteDatabase
+import java.io.File
+
+/** Offline coordinates for Almaty addresses and named places. No addresses are persisted. */
+class OfflineAlmatyIndex(private val context: Context) {
+    fun find(raw: String): BRouterConnector.Point? {
+        val queries = PlaceLookup.queries(raw)
+        val name = queries.lastOrNull() ?: return null
+        val path = indexFile() ?: return null
+        SQLiteDatabase.openDatabase(path.path, null, SQLiteDatabase.OPEN_READONLY or SQLiteDatabase.NO_LOCALIZED_COLLATORS)
+            .use { db ->
+                for (kind in listOf(0, 1)) {
+                    for (key in AlmatyLookupKey.candidates(name, address = kind == 0)) {
+                        val points = db.rawQuery(
+                            "select lat, lon from places where key = ? and kind = ? limit 80",
+                            arrayOf(key, kind.toString())
+                        ).use { cursor ->
+                            buildList {
+                                while (cursor.moveToNext()) add(BRouterConnector.Point(
+                                    cursor.getInt(0) / 1_000_000.0, cursor.getInt(1) / 1_000_000.0
+                                ))
+                            }
+                        }
+                        if (points.isEmpty()) continue
+                        val first = points.first()
+                        if (points.size == 80 || points.any {
+                                kotlin.math.abs(it.lat - first.lat) > 0.0008 ||
+                                    kotlin.math.abs(it.lon - first.lon) > 0.001
+                            }) error("Место не найдено однозначно")
+                        return first
+                    }
+                }
+            }
+        return null
+    }
+
+    @Suppress("DEPRECATION")
+    private fun indexFile(): File? = synchronized(fileLock) {
+        val revision = context.packageManager.getPackageInfo(context.packageName, 0).lastUpdateTime
+        val path = File(context.cacheDir, "almaty-osm-$revision.sqlite")
+        if (path.isFile) return@synchronized path
+        val temp = File(context.cacheDir, "almaty-osm.tmp")
+        runCatching {
+            context.assets.open("almaty-osm.sqlite").use { source ->
+                temp.outputStream().use { target -> source.copyTo(target) }
+            }
+            check(temp.renameTo(path))
+            context.cacheDir.listFiles()?.filter {
+                it != path && it.name.startsWith("almaty-osm-") && it.extension == "sqlite"
+            }?.forEach { it.delete() }
+            path
+        }.onFailure { temp.delete() }.getOrNull()
+    }
+
+    private companion object {
+        val fileLock = Any()
+    }
+}
