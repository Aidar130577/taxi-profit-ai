+/** A trip price has one display window, independent of transient Android window snapshots. */
+class AcceptedFarePopupState {
+    private var identity: String? = null
+    private var destination: String? = null
+    private var shown = false
+    private var until = 0L
+    var accepted = false
+        private set
+
+    fun accept(stableIdentity: String?, place: String?) {
+        accepted = true
+        if (identity == null) identity = stableIdentity
+        if (destination == null) destination = place
+    }
+
+    fun allowsIncoming(stableIdentity: String?, place: String?): Boolean {
+        if (!accepted) return true
+        if (stableIdentity == null) return false
+        val known = identity
+        val target = destination
+        val different = if (known != null) stableIdentity != known
+            else target == null || (place != null && !OrderTextParser.samePoint(target, place))
+        if (different) clear()
+        return different
+    }
+
+    fun showOnce(now: Long): Boolean {
+        if (!accepted || shown) return false
+        shown = true
+        until = now + DISPLAY_MS
+        return true
+    }
+
+    fun isShowing(now: Long) = shown && now < until
+    fun needsPrice() = accepted && !shown
+    fun dismiss() { until = 0L }
+    fun clear() {
+        accepted = false
+        identity = null
+        destination = null
+        shown = false
+        until = 0L
+    }
+
+    companion object { const val DISPLAY_MS = 4_000L }
+}
