+package kz.taxiprofitai
+
+/** Helpers for looking up the named place printed on a passenger offer. */
+object PlaceLookup {
+    data class Match(val lat: Double, val lon: Double, val labels: List<String>)
+
+    private val entrance = Regex("""(?iu)(?:,|\s+[—–-])\s*(?:выход|вход)\b.*$""")
+    private val street = Regex("""(?iu)\b(?:улица|проспект|микрорайон|шоссе|переулок|бульвар|просп)\b|,\s*\d+\s*[А-ЯA-Z]?(?:\s*к(?:орпус)?\s*\d+)?\s*$""")
+    private val prefix = Regex("""(?iu)^(?:кафе|кофейня|ресторан|ТРЦ|ТЦ|БЦ|ЖК|здание|магазин|отель|гостиница)\s+""")
+    private val words = Regex("""[^\p{L}\p{N}]+""")
+
+    fun queries(raw: String): List<String> {
+        val name = raw.replace(entrance, "").trim()
+        val expanded = name.replace(Regex("""(?iu)(\d+[а-я]?)[кk](\d+[а-я]?)$"""), "$1 корпус $2")
+        return listOf(raw, expanded, name).filter(String::isNotBlank).distinct()
+    }
+
+    fun isNamedPlace(text: String): Boolean = text.isNotBlank() && !street.containsMatchIn(text)
+
+    fun namedMatch(name: String, matches: List<Match>): Match? {
+        val key = normalize(name)
+        if (key.length < 3 || key.none(Char::isLetter)) return null
+        // Accept the named object itself. A neighbourhood, a street, or a city-level match cannot substitute for it.
+        val candidates = matches.filter { item ->
+            item.labels.any { label ->
+                label.split(',').any { normalize(it) == key }
+            }
+        }
+        val first = candidates.firstOrNull() ?: return null
+        // Multiple geocoder records for one building are tolerable; separated branches are ambiguous.
+        return first.takeIf { candidates.all { match ->
+            kotlin.math.abs(match.lat - first.lat) <= 0.0008 && kotlin.math.abs(match.lon - first.lon) <= 0.001
+        } }
+    }
+
+    private fun normalize(text: String): String =
+        text.trim().replace(prefix, "").lowercase().replace('ё', 'е').replace(words, " ").trim()
+}
