+package kz.taxiprofitai
+
+import kotlin.math.abs
+
+/** Fits effective prices to previously observed trips, with a chronological holdout. */
+object LearnedRates {
+    data class Profile(val rate: TariffRate, val trips: Int, val adjustments: List<Double>) {
+        fun rateFor(km: Double) = rate.copy(start = rate.start + adjustments[distanceBand(km)])
+    }
+
+    private data class Sample(val km: Double, val minutes: Double, val base: Double, val time: Long)
+    private fun distanceBand(km: Double) = when {
+        km < 4.0 -> 0
+        km < 10.0 -> 1
+        else -> 2
+    }
+
+    fun fit(rate: TariffRate, rows: List<LocalTrial>, now: Long): Profile? {
+        val samples = rows.asSequence().filter {
+            !it.excluded && it.tariff == rate.title && it.tariffRevision == TarifCatalog.lastVerified &&
+                it.createdAtMs in (now - 45L * 86_400_000)..now && it.actualGross != null &&
+                it.fixedSurcharge != null && it.demandMultiplier != null
+        }.mapNotNull { row ->
+            val metered = row.metered
+            val km = if (metered) row.actualKm else row.routeKm ?: row.km
+            val minutes = if (metered) row.actualMinutes else row.routeMinutes ?: row.minutes
+            val gross = row.actualGross!!
+            val fixed = row.fixedSurcharge!!
+            val multiplier = row.demandMultiplier!!
+            if (km == null || minutes == null || km !in 0.05..300.0 || minutes !in 0.5..240.0 ||
+                !gross.isFinite() || fixed !in 0.0..99_900.0 || multiplier !in 1.0..20.0) return@mapNotNull null
+            val base = (gross - fixed) / multiplier
+            Sample(km, minutes, base, row.createdAtMs).takeIf { base in 100.0..100_000.0 }
+        }.sortedBy { it.time }.toList()
+        if (samples.size < 16) return null
+        val checkSize = maxOf(5, samples.size / 4)
+        val training = samples.dropLast(checkSize)
+        val validation = samples.takeLast(checkSize)
+        val fitted = coefficients(rate, training)
+        val bands = (0..2).map { band ->
+            val train = training.filter { distanceBand(it.km) == band }
+            val test = validation.filter { distanceBand(it.km) == band }
+            if (train.size < 5 || test.size < 2) return@map 0.0
+            val residuals = train.map { it.base - predict(fitted, it) }.sorted()
+            val offset = (residuals[(residuals.size - 1) / 2] + residuals[residuals.size / 2]) / 2
+            val limited = offset.coerceIn(-rate.start * 0.35, rate.start * 0.35)
+            if (relativeError(test) { predict(fitted, it) + limited } <
+                relativeError(test) { predict(fitted, it) } * 0.95) limited else 0.0
+        }
+        val initial = relativeError(validation) { predict(rate, it) }
+        val improved = relativeError(validation) { predict(fitted, it) + bands[distanceBand(it.km)] }
+        if (initial <= 0.0 || improved > initial * 0.95) return null
+        return Profile(fitted, samples.size, bands)
+    }
+
+    private fun predict(rate: TariffRate, sample: Sample) = FareEngine.base(rate, RouteEstimate(sample.km, sample.minutes))
+
+    private fun relativeError(rows: List<Sample>, prediction: (Sample) -> Double) =
+        rows.map { abs(prediction(it) - it.base) / it.base }.average()
+
+    private fun coefficients(rate: TariffRate, samples: List<Sample>): TariffRate {
+        val reference = doubleArrayOf(rate.start, rate.perKm, rate.perMinute)
+        val fitted = reference.copyOf()
+        fun features(row: Sample) = doubleArrayOf(1.0, (row.km - rate.includedKm).coerceAtLeast(0.0),
+            (row.minutes - rate.includedMinutes).coerceAtLeast(0.0))
+        val inputs = samples.map { row -> features(row) to row.base }
+        val distinctKm = samples.maxOf { it.km } - samples.minOf { it.km }
+        val distinctMinutes = samples.maxOf { it.minutes } - samples.minOf { it.minutes }
+        repeat(32) {
+            for (i in reference.indices) {
+                if (i == 1 && distinctKm < 3.0 || i == 2 && distinctMinutes < 9.0) continue
+                // Keep minutes and kilometres close to their priors when the samples are correlated.
+                val scale = reference[i].coerceAtLeast(1.0)
+                val shrink = 0.12 / (scale * scale)
+                var square = shrink
+                var target = shrink * reference[i]
+                for ((x, gross) in inputs) {
+                    val other = fitted.indices.filter { it != i }.sumOf { fitted[it] * x[it] }
+                    val weight = 1.0 / (gross * gross)
+                    square += weight * x[i] * x[i]
+                    target += weight * x[i] * (gross - other)
+                }
+                fitted[i] = (target / square).coerceIn(reference[i] * 0.45, reference[i] * 1.65)
+            }
+        }
+        return rate.copy(start = fitted[0], perKm = fitted[1], perMinute = fitted[2])
+    }
+}
