+package kz.taxiprofitai
+
+import java.time.Instant
+import kotlin.math.abs
+
+fun main() {
+    val now = Instant.parse("2026-11-25T13:00:00Z").toEpochMilli()
+    val base = TarifCatalog.forName("Комфорт+")!!
+    val observed = base.copy(start = 725.0, perKm = 91.0, perMinute = 47.0)
+    val rows = List(48) { index ->
+        val km = listOf(1.2, 3.2, 4.4, 8.4, 10.1, 17.1, 2.5, 7.1, 11.2)[index % 9]
+        val minutes = listOf(5.0, 14.0, 10.0, 36.0, 27.0, 30.0, 8.0)[index % 7]
+        val plus = if (index % 3 == 0) 100.0 else 0.0
+        val route = RouteEstimate(km, minutes)
+        LocalTrial(index.toLong(), base.title, FareEngine.base(base, route) + plus, km, minutes,
+            now - (48L - index) * 1_800_000, "test", FareEngine.base(observed, route) + plus,
+            fixedSurcharge = plus, tariffRevision = TarifCatalog.lastVerified, priceSource = FareFactSource.FIXED,
+            demandMultiplier = 1.0, offlineKm = km, actualKm = km * 1.05)
+    }
+    check(LearnedRates.fit(base, rows.take(4), now) == null)
+    check(LearnedRates.fit(base, rows.map { it.copy(excluded = true) }, now) == null)
+    val fit = LearnedRates.fit(base, rows, now)!!
+    for ((km, minutes) in listOf(2.0 to 9.0, 6.0 to 18.0, 12.0 to 25.0)) {
+        val trip = RouteEstimate(km, minutes)
+        val actual = FareEngine.base(observed, trip)
+        check(abs(FareEngine.base(fit.rateFor(km), trip) - actual) < abs(FareEngine.base(base, trip) - actual))
+    }
+    check(RideTimeLearning.distance(6.0, rows, now) > 6.0)
+    val receipt = "Детали заказа\nСтатус\nЗавершен\nНомер заказа\n32203845\nТариф\nКомфорт+\n" +
+        "Оплата от пассажира\n4 090 KZT\nКомиссия парка\n-41 KZT\nДлительность поездки\n01:31:02\nПробег\n12 км"
+    val parsed = TripReceipt.read(receipt)!!
+    check(parsed.orderId == "32203845" && parsed.gross == 4090.0 && parsed.km == 12.0)
+    check(abs(parsed.minutes!! - 91.0333) < 0.001)
+    check(TripReceipt.read(receipt.replace("Завершен", "Отменен")) == null)
+    check(TripReceipt.read(receipt + "\nЧаевые")!!.includesExtras)
+    check(parsed.matches(rows.first().copy(actualKm = 12.0, actualMinutes = 91.0)))
+    check(!parsed.matches(rows.first()))
+    check(TripReceipt.isMetered("Стоимость по таксометру"))
+
+    val first = OrderTextParser.parse("20 м · 1 мин\nБлижняя подача\nКомфорт+\n" +
+        "А улица Манаса, 22Д\nБ Каблан, ул. Наурызбай батыра, 154, Алматы\nПассажир\nПринять ×1.00").copy(trialId = 17)
+    val next = first.copy(pickup = "улица Наурызбай батыра, 156", destination = "улица Пирогова, 32", trialId = 18)
+    val state = TripProgressState()
+    val priceA = TripProgress(false, null, 910.0, "ул. Наурызбай батыра, 154", "Комфорт+")
+    state.remember(first, 1_000)
+    check(state.update(priceA, 2_000)?.trialId == 17L)
+    state.remember(next, 3_000)
+    check(state.update(priceA, 4_000)?.trialId == 17L)
+    state.finishActive()
+    check(state.update(priceA, 5_000) == null)
+    check(state.update(TripProgress(false, null, null, next.destination, next.tariff, metered = true), 6_000)?.trialId == 18L)
+    val timing = RideTiming()
+    timing.startVerified(17, first.destination!!, 1_000)
+    timing.offer(18, next.destination!!, 2_000)
+    check(timing.observe(RidePhase.COMPLETED, emptyList(), 61_000) == RideTiming.Fact(17, 1.0))
+    timing.startVerified(18, next.destination, 65_000)
+    check(timing.observe(RidePhase.COMPLETED, emptyList(), 125_000) == RideTiming.Fact(18, 1.0))
+    println("Verified automatic price pairing, receipt rules, queued rides, and learning across distances")
+}
