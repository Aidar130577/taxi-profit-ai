+package kz.taxiprofitai
+
+enum class FareFactSource { FIXED, RECEIPT, MANUAL }
+
+data class TripReceipt(val orderId: String, val gross: Double, val minutes: Double?, val km: Double?, val tariff: String? = null, val includesExtras: Boolean = false) {
+    fun matches(row: LocalTrial): Boolean {
+        if (tariff != row.tariff || row.excluded) return false
+        val minutesMatch = minutes != null && row.actualMinutes != null &&
+            kotlin.math.abs(row.actualMinutes - minutes) <= maxOf(1.0, minutes * 0.15)
+        val kmMatch = km != null && row.actualKm != null &&
+            kotlin.math.abs(row.actualKm - km) <= maxOf(0.75, km * 0.2)
+        if (minutes != null && row.actualMinutes != null && !minutesMatch ||
+            km != null && row.actualKm != null && !kmMatch) return false
+        return minutesMatch || kmMatch || row.priceSource == FareFactSource.FIXED && row.actualGross == gross
+    }
+
+    companion object {
+        fun read(text: String): TripReceipt? {
+            val rows = text.replace('\u00a0', ' ').replace('\u202f', ' ')
+                .lines().map(String::trim).filter(String::isNotEmpty)
+            fun values(label: String): List<String> {
+                val field = Regex("""(?iu)^${Regex.escape(label)}(?:\s*[:·]?\s*(.*))?$""")
+                return rows.mapIndexedNotNull { index, row ->
+                    field.matchEntire(row)?.groupValues?.get(1)?.trim()?.ifEmpty { rows.getOrNull(index + 1).orEmpty() }
+                }.distinct()
+            }
+            if (!rows.any { it.equals("Детали заказа", true) || it.equals("Расчёт стоимости", true) ||
+                    it.equals("Расчет стоимости", true) }) return null
+            val finished = values("Статус").singleOrNull()?.lowercase()?.replace('ё', 'е')
+            if (finished !in setOf("завершен", "завершена", "выполнен", "выполнена")) return null
+            val id = values("Номер заказа").singleOrNull()?.let {
+                Regex("""^\d{6,20}$""").find(it)?.value
+            } ?: return null
+            val money = Regex("""(?iu)^(\d{1,7}|\d{1,3}(?: \d{3})+)\s*(?:₸|kzt|тг\.?|тенге|т)$""")
+            val gross = values("Оплата от пассажира").singleOrNull()?.let {
+                money.matchEntire(it)?.groupValues?.get(1)?.replace(" ", "")?.toDoubleOrNull()
+            }?.takeIf { it in 1.0..100_000.0 } ?: return null
+            val extras = rows.any {
+                Regex("""(?iu)^(?:чаевые|платное ожидание|скидка|бонус|доплата)(?:\s|$)""").containsMatchIn(it)
+            }
+            val time = values("Длительность поездки").singleOrNull()?.let {
+                Regex("""^(\d{1,2}):(\d{2})(?::(\d{2}))?$""").matchEntire(it)?.destructured
+            }?.let { (first, second, third) ->
+                if (third.isEmpty()) first.toInt() + second.toInt() / 60.0
+                else first.toInt() * 60.0 + second.toInt() + third.toInt() / 60.0
+            }?.takeIf { it in 0.5..240.0 }
+            val km = values("Пробег").singleOrNull()?.let {
+                Regex("""(?iu)^(\d+(?:[,.]\d+)?)\s*(км|м)$""").matchEntire(it)?.destructured
+            }?.let { (number, unit) ->
+                number.replace(',', '.').toDouble() / if (unit.equals("м", true)) 1000.0 else 1.0
+            }?.takeIf { it in 0.05..300.0 }
+            return TripReceipt(id, gross, time, km, TarifCatalog.forName(values("Тариф").singleOrNull())?.title, extras)
+        }
+
+        fun isMetered(text: String): Boolean = Regex(
+            """(?iu)(?<!\p{L})(?:по\s+таксометру|стоимость\s+по\s+сч[её]тчику|цена\s+по\s+сч[её]тчику)(?!\p{L})"""
+        ).containsMatchIn(text)
+    }
+}
