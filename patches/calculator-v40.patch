+package kz.taxiprofitai
+
+import android.content.Context
+import org.json.JSONObject
+import java.security.MessageDigest
+
+/** Device-local lookup for addresses previously missing from the offline index. */
+object LearnedPlaces {
+    private const val FILE = "learned_city_points"
+    private const val MAX_ENTRIES = 600
+
+    private fun key(raw: String): String? {
+        val text = PlaceLookup.streetAddress(raw) ?: raw
+        val address = !PlaceLookup.isNamedPlace(text)
+        val normalized = AlmatyLookupKey.candidates(text, address).lastOrNull() ?: return null
+        return MessageDigest.getInstance("SHA-256").digest(normalized.toByteArray(Charsets.UTF_8))
+            .joinToString("") { "%02x".format(it) }
+    }
+
+    @Synchronized fun remember(context: Context, raw: String, point: BRouterConnector.Point, verified: Boolean) {
+        if (point.lat !in 42.5..44.5 || point.lon !in 75.0..79.0) return
+        val key = key(raw) ?: return
+        val prefs = context.getSharedPreferences(FILE, Context.MODE_PRIVATE)
+        val entries = prefs.all
+        val old = entries[key]?.let(::decode)
+        val nearby = old != null && kotlin.math.abs(old.point.lat - point.lat) < 0.00033 &&
+            kotlin.math.abs(old.point.lon - point.lon) < 0.00045
+        val evidence = when {
+            verified -> 2
+            old != null && old.count >= 2 -> return
+            nearby -> 2
+            else -> 1
+        }
+        val data = JSONObject().put("lat", point.lat).put("lon", point.lon)
+            .put("count", evidence).put("date", System.currentTimeMillis())
+        val editor = prefs.edit().putString(key, data.toString())
+        if (old == null && entries.size >= MAX_ENTRIES) {
+            entries.minByOrNull { decode(it.value)?.date ?: 0 }?.let { editor.remove(it.key) }
+        }
+        editor.apply()
+    }
+
+    @Synchronized fun find(context: Context, raw: String): BRouterConnector.Point? {
+        val key = key(raw) ?: return null
+        return decode(context.getSharedPreferences(FILE, Context.MODE_PRIVATE).getString(key, null))
+            ?.takeIf { it.count >= 2 }?.point
+    }
+
+    @Synchronized fun points(context: Context): List<BRouterConnector.Point> =
+        context.getSharedPreferences(FILE, Context.MODE_PRIVATE).all.values
+            .mapNotNull(::decode).filter { it.count >= 2 }.map { it.point }.distinct()
+
+    private data class Entry(val point: BRouterConnector.Point, val count: Int, val date: Long)
+
+    private fun decode(value: Any?): Entry? = if (value !is String) null else runCatching {
+        val json = JSONObject(value)
+        Entry(BRouterConnector.Point(json.getDouble("lat"), json.getDouble("lon")),
+            json.getInt("count"), json.getLong("date"))
+    }.getOrNull()
+}
