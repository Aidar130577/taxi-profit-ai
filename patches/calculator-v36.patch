+package kz.taxiprofitai
+
+import android.app.ActivityManager
+import android.app.ApplicationExitInfo
+import android.content.Context
+import android.os.Build
+
+object ServiceExitDiagnostics {
+    fun summary(context: Context): String? {
+        if (Build.VERSION.SDK_INT < 30) return null
+        return runCatching {
+            val app = context.packageName
+            val started = System.currentTimeMillis() - 24 * 60 * 60_000L
+            val manager = context.getSystemService(ActivityManager::class.java) ?: return null
+            manager.getHistoricalProcessExitReasons(app, 0, 12)
+                .firstOrNull { it.processName == app && it.timestamp >= started }
+                ?.let { record ->
+                    val label = when (record.reason) {
+                        ApplicationExitInfo.REASON_CRASH -> "необработанная ошибка приложения"
+                        ApplicationExitInfo.REASON_CRASH_NATIVE -> "сбой нативного кода"
+                        ApplicationExitInfo.REASON_ANR -> "приложение не отвечало"
+                        ApplicationExitInfo.REASON_LOW_MEMORY -> "нехватка памяти"
+                        ApplicationExitInfo.REASON_USER_REQUESTED -> "процесс закрыт по запросу системы или пользователя"
+                        else -> "завершение процесса"
+                    }
+                    "Системная диагностика · $label · код ${record.reason}"
+                }
+        }.getOrNull()
+    }
+}
