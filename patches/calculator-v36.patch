+package kz.taxiprofitai
+
+import android.app.Service
+import android.content.Intent
+import android.graphics.ColorSpace
+import android.hardware.HardwareBuffer
+import android.os.Bundle
+import android.os.Handler
+import android.os.IBinder
+import android.os.Looper
+import android.os.Message
+import android.os.Messenger
+import android.os.RemoteException
+
+/** Tesseract lives outside the Android accessibility service's process. */
+class OcrWorkerService : Service() {
+    private val incoming by lazy { WindowOcr(this) }
+    private val progress by lazy { WindowOcr(this, "ocr-progress-v1") }
+    private val messenger = Messenger(Handler(Looper.getMainLooper()) { message ->
+        when (message.what) {
+            OcrProtocol.PREPARE -> incoming.prepare()
+            OcrProtocol.READ -> read(message)
+        }
+        true
+    })
+
+    @Suppress("DEPRECATION")
+    private fun read(message: Message) {
+        val data = message.data
+        val buffer = data.getParcelable<HardwareBuffer>("buffer")
+        val reply = message.replyTo
+        if (reply == null || buffer == null) {
+            buffer?.close()
+            if (reply != null) sendReply(reply, message.arg1, null, true)
+            return
+        }
+        val space = ColorSpace.Named.values().map(ColorSpace::get)
+            .firstOrNull { it.id == data.getInt("colorSpace") } ?: ColorSpace.get(ColorSpace.Named.SRGB)
+        val isProgress = data.getBoolean("progress")
+        val worker = if (isProgress) progress else incoming
+        val request = message.arg1
+        worker.recognize(buffer, space, data.getBoolean("badgeOnly"), isProgress,
+            ready = { sendReply(reply, request, it, false) },
+            done = { sendReply(reply, request, it, true) })
+    }
+
+    private fun sendReply(reply: Messenger, id: Int, reading: WindowOcr.Reading?, done: Boolean) {
+        val message = Message.obtain(null, OcrProtocol.RESULT, id, if (done) 1 else 0)
+        message.data = OcrProtocol.encode(reading)
+        try { reply.send(message) } catch (_: RemoteException) {}
+    }
+
+    override fun onBind(intent: Intent?): IBinder = messenger.binder
+
+    override fun onDestroy() {
+        incoming.close()
+        progress.close()
+        super.onDestroy()
+    }
+}
+
+internal object OcrProtocol {
+    const val PREPARE = 1
+    const val READ = 2
+    const val RESULT = 3
+
+    fun encode(reading: WindowOcr.Reading?) = Bundle().apply {
+        if (reading == null) return@apply
+        putBoolean("reading", true)
+        putString("text", reading.text)
+        if (reading.purple != null) putLong("purple", reading.purple)
+        putBoolean("cardOnly", reading.cardOnly)
+        putBadge("badge", reading.badge)
+        reading.progress?.let {
+            putBoolean("progress", true)
+            putBoolean("selecting", it.selecting)
+            putBadge("route", it.route)
+            if (it.gross != null) putDouble("gross", it.gross)
+            putString("destination", it.destination)
+            putString("tariff", it.tariff)
+        }
+    }
+
+    fun decode(data: Bundle): WindowOcr.Reading? {
+        if (!data.getBoolean("reading")) return null
+        val progress = if (data.getBoolean("progress")) {
+            TripProgress(data.getBoolean("selecting"), data.badge("route"),
+                data.getDouble("gross").takeIf { data.containsKey("gross") },
+                data.getString("destination"), data.getString("tariff"))
+        } else null
+        return WindowOcr.Reading(data.getString("text"), data.getLong("purple").takeIf { data.containsKey("purple") },
+            data.getBoolean("cardOnly"), data.badge("badge"), progress)
+    }
+
+    private fun Bundle.putBadge(key: String, value: TripBadge?) {
+        if (value != null) {
+            putDouble("${key}Km", value.km)
+            putInt("${key}Minutes", value.minutes)
+        }
+    }
+
+    private fun Bundle.badge(key: String): TripBadge? =
+        if (containsKey("${key}Km")) TripBadge(getDouble("${key}Km"), getInt("${key}Minutes")) else null
+}
