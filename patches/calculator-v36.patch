+package kz.taxiprofitai
+
+import android.content.ComponentName
+import android.content.Context
+import android.content.Intent
+import android.content.ServiceConnection
+import android.hardware.HardwareBuffer
+import android.os.Bundle
+import android.os.Handler
+import android.os.IBinder
+import android.os.Looper
+import android.os.Message
+import android.os.Messenger
+import android.os.RemoteException
+import android.os.SystemClock
+
+/** All client methods and callbacks run on the main thread. Frames stay in memory. */
+class OcrClient(context: Context) {
+    private val app = context.applicationContext
+    private val handler = Handler(Looper.getMainLooper())
+    private data class Request(
+        val data: Bundle,
+        var buffer: HardwareBuffer?,
+        val ready: (WindowOcr.Reading) -> Unit,
+        val done: (WindowOcr.Reading?) -> Unit,
+        val timeout: Runnable
+    )
+    private val pending = linkedMapOf<Int, Request>()
+    private var nextId = 0
+    private var worker: Messenger? = null
+    private var bound = false
+    private var closed = false
+    private var retryAfter = 0L
+    private val reply = Messenger(Handler(Looper.getMainLooper()) { message ->
+        if (message.what == OcrProtocol.RESULT) {
+            val id = message.arg1
+            val request = pending[id]
+            if (request != null) {
+                val result = OcrProtocol.decode(message.data)
+                if (message.arg2 == 1) finish(id, result) else result?.let(request.ready)
+            }
+        }
+        true
+    })
+    private val connection = object : ServiceConnection {
+        override fun onServiceConnected(name: ComponentName?, binder: IBinder?) {
+            if (closed || !bound || binder == null) return
+            worker = Messenger(binder)
+            try {
+                worker?.send(Message.obtain(null, OcrProtocol.PREPARE))
+                for ((id, request) in pending.toMap()) dispatch(id, request)
+            } catch (_: RemoteException) { unavailable() }
+        }
+
+        override fun onServiceDisconnected(name: ComponentName?) = unavailable()
+        override fun onBindingDied(name: ComponentName?) = unavailable()
+        override fun onNullBinding(name: ComponentName?) = unavailable()
+    }
+
+    fun prepare() {
+        if (closed || bound || SystemClock.elapsedRealtime() < retryAfter) return
+        bound = runCatching {
+            app.bindService(Intent(app, OcrWorkerService::class.java), connection, Context.BIND_AUTO_CREATE)
+        }.getOrDefault(false)
+        if (!bound) unavailable()
+    }
+
+    fun recognize(
+        buffer: HardwareBuffer, colorSpace: Int, badgeOnly: Boolean, progress: Boolean,
+        ready: (WindowOcr.Reading) -> Unit, done: (WindowOcr.Reading?) -> Unit
+    ) {
+        prepare()
+        if (closed || !bound) {
+            buffer.close()
+            done(null)
+            return
+        }
+        val id = ++nextId
+        val timeout = Runnable { finish(id, null) }
+        val data = Bundle().apply {
+            putInt("colorSpace", colorSpace)
+            putBoolean("badgeOnly", badgeOnly)
+            putBoolean("progress", progress)
+        }
+        val request = Request(data, buffer, ready, done, timeout)
+        pending[id] = request
+        handler.postDelayed(timeout, 4_200L)
+        try { dispatch(id, request) } catch (_: RemoteException) { unavailable() }
+    }
+
+    private fun dispatch(id: Int, request: Request) {
+        val peer = worker ?: return
+        val frame = request.buffer ?: return
+        val message = Message.obtain(null, OcrProtocol.READ, id, 0)
+        message.replyTo = reply
+        message.data = Bundle(request.data).apply { putParcelable("buffer", frame) }
+        try {
+            peer.send(message)
+        } finally {
+            request.buffer = null
+            frame.close()
+        }
+    }
+
+    private fun finish(id: Int, result: WindowOcr.Reading?) {
+        val request = pending.remove(id) ?: return
+        handler.removeCallbacks(request.timeout)
+        request.buffer?.close()
+        request.done(result)
+    }
+
+    private fun unavailable() {
+        retryAfter = SystemClock.elapsedRealtime() + 30_000L
+        release()
+    }
+
+    private fun release() {
+        worker = null
+        if (bound) {
+            bound = false
+            runCatching { app.unbindService(connection) }
+        }
+        pending.keys.toList().forEach { finish(it, null) }
+    }
+
+    fun close() {
+        if (closed) return
+        closed = true
+        release()
+    }
+}
