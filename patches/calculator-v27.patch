+    /** The order card occupies the bottom of the map. Read it in line order. */
+    private fun readOrderCard(bitmap: Bitmap, api: TessBaseAPI): String? {
+        val top = (bitmap.height * 0.622).toInt()
+        val crop = Bitmap.createBitmap(bitmap, 0, top, bitmap.width, bitmap.height - top)
+        val scale = (960.0 / crop.width).coerceIn(1.0, 1.5)
+        val card = Bitmap.createScaledBitmap(crop, (crop.width * scale).toInt(), (crop.height * scale).toInt(), true)
+        return try {
+            api.setPageSegMode(TessBaseAPI.PageSegMode.PSM_SINGLE_BLOCK)
+            api.setImage(card)
+            val raw = api.getUTF8Text() ?: return null
+            val offer = OrderTextParser.parse(raw)
+            raw.takeIf {
+                api.meanConfidence() >= 55 && offer.order && offer.pickup != null && offer.destination != null
+            }
+        } finally {
+            api.clear()
+            api.setPageSegMode(TessBaseAPI.PageSegMode.PSM_SPARSE_TEXT)
+            if (card !== crop) card.recycle()
+            if (crop !== bitmap) crop.recycle()
+        }
+    }
