+package kz.taxiprofitai
+
+/** Distance and ETA from the destination badge in the order map. */
+data class TripBadge(val km: Double, val minutes: Int) {
+    fun route() = OfflineRoute(km, minutes.toDouble(), "Время Яндекс Про")
+}
+
+object TripBadgeReader {
+    private val marker = Regex("""(?iu)^\s*(?:\([БB]\)|[БB](?=[:.\s]|$))\s*[:.]?\s*(.*)$""")
+    private val metrics = Regex(
+        """(?iu)^\s*(\d{1,4}(?:[.,]\d{1,2})?)\s*(км|km|м|m)\s*[·•,|—-]?\s*(?:(\d{1,2})\s*(?:ч|h)\.?\s*)?(?:(\d{1,3})\s*(?:мин|min)\.?)?\s*$"""
+    )
+
+    private val distanceLine = Regex("""(?iu)^\d{1,4}(?:[.,]\d{1,2})?\s*(?:км|km|м|m)$""")
+    private val measurement = Regex("""(?iu)^\d[\d.,\s·•-]*(?:км|km|м|m|ч|h|мин|min)(?:\s+\d{1,3}\s*(?:мин|min))?\.?$""")
+    fun isMeasurement(text: String): Boolean = measurement.matches(text)
+
+    fun read(text: String): TripBadge? {
+        val lines = text.replace('\u00a0', ' ').replace('\u202f', ' ').lines().map(String::trim).filter(String::isNotEmpty)
+        return lines.indices.mapNotNull { i ->
+            val own = marker.matchEntire(lines[i])?.groupValues?.get(1) ?: return@mapNotNull null
+            if (own.isBlank() && lines.getOrNull(i + 1)?.let(distanceLine::matches) != true) {
+                return@mapNotNull null
+            }
+            for (end in minOf(i + 2, lines.lastIndex) downTo i) {
+                val data = (listOf(own) + lines.subList(i + 1, end + 1)).joinToString(" ")
+                val badge = parseMetrics(data)
+                if (badge != null) return@mapNotNull badge
+            }
+            null
+        }.distinct().singleOrNull()
+    }
+
+    private fun parseMetrics(data: String): TripBadge? {
+        val match = metrics.matchEntire(data)?.groupValues ?: return null
+        val distance = match[1].replace(',', '.').toDoubleOrNull() ?: return null
+        val km = if (match[2].equals("м", true) || match[2].equals("m", true)) distance / 1000 else distance
+        val hours = match[3].toIntOrNull() ?: 0
+        val remainder = match[4].toIntOrNull() ?: 0
+        if (hours > 0 && remainder >= 60) return null
+        val total = hours * 60 + remainder
+        return TripBadge(km, total).takeIf {
+            km in 0.1..150.0 && total in 1..360 && km * 60 / total <= 145.0
+        }
+    }
+}
+
+/** Connected dark shapes in the map, filtered to the proportions of a route badge. */
+internal object TripBadgeRegions {
+    data class Box(val left: Int, val top: Int, val right: Int, val bottom: Int)
+
+    fun find(dark: BooleanArray, width: Int, height: Int): List<Box> {
+        val found = mutableListOf<Pair<Int, Box>>()
+        val queue = IntArray(dark.size)
+        fun enqueue(index: Int, tail: Int): Int {
+            if (!dark[index]) return tail
+            dark[index] = false
+            queue[tail] = index
+            return tail + 1
+        }
+        for (index in dark.indices) {
+            if (!dark[index]) continue
+            var head = 0
+            var tail = enqueue(index, 0)
+            var left = width
+            var top = height
+            var right = 0
+            var bottom = 0
+            while (head < tail) {
+                val cell = queue[head++]
+                val y = cell / width
+                val x = cell % width
+                left = minOf(left, x)
+                top = minOf(top, y)
+                right = maxOf(right, x)
+                bottom = maxOf(bottom, y)
+                if (x > 0) tail = enqueue(cell - 1, tail)
+                if (x + 1 < width) tail = enqueue(cell + 1, tail)
+                if (y > 0) tail = enqueue(cell - width, tail)
+                if (y + 1 < height) tail = enqueue(cell + width, tail)
+            }
+            val w = right - left + 1
+            val h = bottom - top + 1
+            if (w in (width * 0.21)..(width * 0.65) && h in (width * 0.055)..(width * 0.20) &&
+                w.toDouble() / h in 1.8..4.8 && tail > w * h * 0.33) {
+                found.add(tail to Box(left, top, right + 1, bottom + 1))
+            }
+        }
+        return found.sortedByDescending { it.first }.take(4).map { it.second }
+    }
+}
