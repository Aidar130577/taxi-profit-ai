+    check(read.destination == "Центральная улица, 8")
+    check(TripBadgeReader.read("Б 12 км 1ч20 мин") == badge)
+    check(TripBadgeReader.read("Б 12 км\n1 ч 20 мин") == badge)
+    check(TripBadgeReader.read("Б 900 м 4 мин") == TripBadge(0.9, 4))
+    check(TripBadgeReader.read("А 12 км 1 ч 20 мин") == null)
+    check(TripBadgeReader.read("Б\n500 м · 4 мин") == null)
+    check(TripBadgeReader.read("Б 12 км 1 ч 60 мин") == null)
+    check(TripBadgeReader.read("12 км\n1 ч 20 мин") == null)
