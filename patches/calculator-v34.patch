+package kz.taxiprofitai
+
+/** Visible stages after the driver has accepted an offer. */
+data class TripProgress(
+    val selecting: Boolean, val route: TripBadge?, val gross: Double?, val destination: String?, val tariff: String?
+)
+
+object TripProgressReader {
+    private val selectTitle = Regex("""(?iu)^укажите\s+маршрут\b""")
+    private val go = Regex("""(?iu)^поехали\b""")
+    private val finish = Regex("""(?iu)^(?:[^\p{L}\d]*|[0-9]+\s+)завершить(?:\s+поездку)?\s*$""")
+    private val amountCaption = Regex("""(?iu)стоимость\s+поездки\s+с\s+уч[её]том\s+пробок""")
+    private val amount = Regex("""(?iu)(?<![\d.,+])(?<!от\s)(\d{1,3}(?:\s\d{3})+|\d{1,6})\s*(?:₸|тг\.?|тенге|[тt])\s*$""")
+    private val pay = Regex("""(?iu)оплата\s+(?:картой|наличными)""")
+    private val destinationRow = Regex("""(?iu)^\s*(?:\([БB5]\)|[БB](?=\s|[:.]|$))\s*[:.]?\s*(.+)$""")
+    private val bareDestination = Regex("""(?iu)^\(?[БB]\)?[:.]?$""")
+    private val clockSuffix = Regex("""\s+\d{1,2}:\d{2}(?:\s+[^\p{L}\d])?\s*$""")
+
+    fun selecting(text: String): Boolean {
+        val lines = rows(text)
+        return lines.any(selectTitle::containsMatchIn) && (lines.any(go::containsMatchIn) ||
+            lines.count { TripBadgeReader.parseMetrics(it) != null } >= 2)
+    }
+
+    fun read(text: String, selected: TripBadge? = null): TripProgress? {
+        val lines = rows(text)
+        if (lines.any(selectTitle::containsMatchIn) && (lines.any(go::containsMatchIn) ||
+                lines.count { TripBadgeReader.parseMetrics(it) != null } >= 2)) {
+            return TripProgress(true, selected, null, null, null)
+        }
+        val tariff = TarifCatalog.titles.sortedByDescending(String::length).firstOrNull { name ->
+            lines.any { it.equals(name, true) || pay.containsMatchIn(it) && it.endsWith(name, true) }
+        }
+        val destination = lines.mapIndexedNotNull { i, line ->
+            val tail = destinationRow.matchEntire(line)?.groupValues?.get(1)
+                ?: lines.getOrNull(i + 1)?.takeIf { bareDestination.matches(line) }
+            tail?.replace(clockSuffix, "")?.takeIf {
+                it.any(Char::isLetter) && !TripBadgeReader.isMeasurement(it) &&
+                    it.any(Char::isDigit) && !pay.containsMatchIn(it)
+            }
+        }.distinct().singleOrNull()
+        val payment = lines.any(pay::containsMatchIn)
+        val caption = lines.indexOfFirst(amountCaption::containsMatchIn)
+        val active = (lines.any(finish::matches) && (payment || caption >= 0)) ||
+            (payment && destination != null && tariff != null && lines.any { clockSuffix.containsMatchIn(it) })
+        if (!active) return null
+        val gross = if (caption >= 0) {
+            lines.subList((caption - 1).coerceAtLeast(0), (caption + 2).coerceAtMost(lines.size))
+                .mapNotNull { line ->
+                    val value = amount.find(line)?.groupValues?.get(1)?.filter(Char::isDigit)?.toDoubleOrNull()
+                    value?.takeIf { it in 1.0..100_000.0 && (pay.containsMatchIn(line) ||
+                        amountCaption.containsMatchIn(line) || amount.matches(line)) }
+                }.distinct().singleOrNull()
+        } else null
+        val nav = lines.indices.mapNotNull { i ->
+            val row = lines[i]
+            if (!clockSuffix.containsMatchIn(row) && !row.matches(Regex("""\d{1,2}:\d{2}"""))) {
+                return@mapNotNull null
+            }
+            TripBadgeReader.parseMetrics(row.replace(clockSuffix, ""))
+                ?: if (i >= 2 && row.matches(Regex("""\d{1,2}:\d{2}"""))) {
+                    TripBadgeReader.parseMetrics(lines[i - 2] + " " + lines[i - 1])
+                } else null
+        }.distinct().singleOrNull()
+        return TripProgress(false, nav, gross, destination, tariff)
+    }
+
+    private fun rows(text: String) = text.replace('\u00a0', ' ').replace('\u202f', ' ')
+        .lines().map(String::trim).filter(String::isNotEmpty)
+}
+
+class TripProgressState {
+    private var incoming: OrderTextParser.Detected? = null
+    private var seenAt = 0L
+    private var selected: TripBadge? = null
+    private var active: OrderTextParser.Detected? = null
+    private var activeAt: Long? = null
+
+    fun hasContext(now: Long) = active != null || incoming != null && now - seenAt in 0L..600_000L
+
+    fun remember(offer: OrderTextParser.Detected, now: Long) {
+        val prior = incoming
+        if (prior?.destination != offer.destination || prior?.pickup != offer.pickup || prior?.tariff != offer.tariff || active != null) {
+            clear()
+        }
+        incoming = offer
+        seenAt = now
+    }
+
+    fun update(progress: TripProgress, now: Long): OrderTextParser.Detected? {
+        val prior = incoming?.takeIf { now - seenAt in 0L..600_000L }
+        if (progress.selecting) {
+            val offer = prior ?: return null
+            if (active != null) return null
+            selected = progress.route ?: selected
+            return offer.copy(tripBadge = selected ?: offer.tripBadge)
+        }
+        val match = progress.destination
+        val linked = (active ?: prior)?.takeIf { known ->
+            match != null && known.destination?.let { OrderTextParser.samePoint(it, match) } == true &&
+                (progress.tariff == null || progress.tariff == known.tariff)
+        }
+        val last = active
+        if (linked == null && (progress.gross == null || progress.tariff == null)) return null
+        if (linked == null) {
+            active = null
+            activeAt = null
+            selected = null
+        }
+        val started = activeAt ?: now.also { activeAt = it }
+        val chosen = selected ?: linked?.tripBadge
+        val earlyNav = progress.route?.takeIf { now - started in 0L..60_000L &&
+            (chosen == null || it.km in chosen.km * 0.90..chosen.km * 1.12) }
+        val actualPrice = progress.gross ?: linked?.displayedGross?.takeIf { last != null }
+        val quote = (linked ?: OrderTextParser.Detected(
+            true, progress.tariff, null, false, null, match, null, null
+        )).copy(displayedGross = actualPrice,
+            tripBadge = earlyNav ?: last?.tripBadge?.takeIf { linked != null } ?: selected ?: linked?.tripBadge)
+        active = quote
+        return quote
+    }
+
+    fun clear() {
+        incoming = null
+        selected = null
+        active = null
+        activeAt = null
+        seenAt = 0L
+    }
+}
