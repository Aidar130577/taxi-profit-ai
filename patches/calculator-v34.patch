+    private fun readProgress(bitmap: Bitmap, api: TessBaseAPI): TripProgress? {
+        val top = (bitmap.height * .51).toInt()
+        val bottom = (bitmap.height * .985).toInt()
+        val card = Bitmap.createBitmap(bitmap, 0, top, bitmap.width, bottom - top)
+        val raw = try {
+            api.setPageSegMode(TessBaseAPI.PageSegMode.PSM_SINGLE_BLOCK)
+            api.setImage(card)
+            api.getUTF8Text()?.takeIf { api.meanConfidence() >= 48 }
