+package kz.taxiprofitai
+
+import kotlin.math.abs
+
+fun main() {
+    val initial = OrderTextParser.parse("Пропустить\nБ 12 км 1 ч 20 мин\n500 м · 4 мин\nБлижняя подача\n" +
+        "Комфорт+\nА: улица Богенбай батыра, 135\nБ: Центральная улица, 8\nПассажир\nПринять ×1.00")
+    val chooser = "Укажите маршрут\n12 км · 1 ч 2 мин\n12 км · 1 ч 7 мин\n12 км · 1 ч 15 мин\n11 км · 1 ч 17 мин\nПоехали"
+    val selected = TripProgressReader.read(chooser, TripBadge(12.0, 62))!!
+    check(selected.selecting && selected.route == TripBadge(12.0, 62))
+    check(TripProgressReader.read(chooser)?.route == null)
+    val nav = "480 м\nулица Магаза Масанчи\n12 км 1ч1 мин 19:00\n(5) Центральная улица, 8 04:37\nОплата картой Комфорт+"
+    val firstNav = TripProgressReader.read(nav)!!
+    check(!firstNav.selecting && firstNav.route == TripBadge(12.0, 61) && firstNav.gross == null)
+    val inProgress = "(5) Центральная улица, 8 04:43\n[28 Оплата картой 4090т\n" +
+        "Стоимость поездки с учетом пробок\n© Пассажир 5.00\nКомфорт+\nОжидание\n© Завершить"
+    val price = TripProgressReader.read(inProgress)!!
+    check(price.gross == 4090.0 && price.destination == "Центральная улица, 8")
+    check(TripProgressReader.read(inProgress.replace("4090т", "+4090т"))?.gross == null)
+    check(TripProgressReader.read(inProgress.replace("4090т", "от 4090т"))?.gross == null)
+    check(TripProgressReader.read(inProgress.replace("Стоимость поездки с учетом пробок", ""))?.gross == null)
+    check(TripProgressReader.read("от 1230 ₸\nПоехали") == null)
+
+    val state = TripProgressState()
+    check(state.update(selected, 1L) == null)
+    state.remember(initial, 1_000)
+    check(state.update(selected, 241_000)?.tripBadge == TripBadge(12.0, 62))
+    check(state.update(firstNav, 260_000)?.tripBadge == TripBadge(12.0, 61))
+    check(state.update(firstNav.copy(route = TripBadge(7.0, 42)), 560_000)?.tripBadge == TripBadge(12.0, 61))
+    check(state.update(price, 561_000)?.let { it.displayedGross == 4090.0 && it.pickup == initial.pickup } == true)
+    check(state.update(firstNav, 563_000)?.displayedGross == 4090.0)
+    state.clear()
+    check(state.update(firstNav, 564_000) == null)
+    check(state.update(price, 565_000)?.pickup == null)
+    val net = CommissionCatalog.calculate(4090.0, 4090.0, 19.2, 1.0).net!!
+    check(abs(net - 3263.82) < 0.01)
+    println("Incoming, selected route, remaining ETA, and displayed in-trip price verified")
+}
