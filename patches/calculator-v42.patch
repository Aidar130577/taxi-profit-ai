+package kz.taxiprofitai
+
+import java.io.File
+import kotlin.system.measureTimeMillis
+
+fun main(args: Array<String>) {
+    val engine = EmbeddedRoadRouter(File(args.single()))
+    println("Profile warm-up: ${measureTimeMillis { engine.warmProfile() }} ms")
+    val routes = listOf(
+        doubleArrayOf(43.2389, 76.8897, 43.2449, 76.9063, 1.0, 4.0),
+        doubleArrayOf(43.2523, 76.9345, 43.2017, 76.8704, 8.0, 17.0),
+        doubleArrayOf(43.2246, 76.8535, 43.3509, 77.0222, 20.0, 40.0),
+    )
+    for (row in routes) {
+        val latency = measureTimeMillis {
+            val result = engine.route(row[0], row[1], row[2], row[3])
+            check(!result.provisional && result.km in row[4]..row[5] && result.minutes > 0) { result }
+            print("${result.km} km / ${result.minutes} min: ")
+        }
+        println("$latency ms")
+    }
+    check(runCatching { engine.route(51.1, 71.4, 51.2, 71.5) }.isFailure)
+}
