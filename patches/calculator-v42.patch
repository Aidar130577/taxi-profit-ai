+package kz.taxiprofitai
+
+import btools.router.ProfileCache
+import btools.router.RoutingContext
+import btools.router.RoutingEngine
+import btools.router.RoutingParamCollector
+import java.io.File
+
+/** Uses the BRouter Java core with the bundled car profile and offline road tile. */
+internal class EmbeddedRoadRouter(private val data: File) {
+    private fun context() = RoutingContext().apply {
+        localFunction = File(data, "car-vario.brf").absolutePath
+        memoryclass = 32
+    }
+
+    fun warmProfile() {
+        val routing = context()
+        try {
+            ProfileCache.parseProfile(routing)
+        } finally {
+            ProfileCache.releaseProfile(routing)
+        }
+    }
+
+    fun route(fromLat: Double, fromLon: Double, toLat: Double, toLon: Double): OfflineRoute {
+        require(covers(fromLat, fromLon) && covers(toLat, toLon)) { "Точка вне офлайн-карты Алматы" }
+        val waypoints = RoutingParamCollector().readPositions(
+            doubleArrayOf(fromLon, toLon), doubleArrayOf(fromLat, toLat)
+        )
+        val routing = context()
+        val engine = RoutingEngine(null, null, data, waypoints, routing, RoutingEngine.BROUTER_ENGINEMODE_ROUTING)
+        engine.quite = true
+        engine.doRun(2_000)
+        val result = engine.foundTrack ?: error(engine.errorMessage ?: "Встроенный BRouter не нашёл маршрут")
+        require(result.distance >= 20 && result.totalSeconds > 0) { "Маршрут слишком короткий для расчёта" }
+        return OfflineRoute(result.distance / 1000.0, result.totalSeconds / 60.0)
+    }
+
+    private fun covers(lat: Double, lon: Double) = lat >= 40.0 && lat < 45.0 && lon >= 75.0 && lon < 80.0
+}
